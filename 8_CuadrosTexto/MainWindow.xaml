<Window x:Class="_8_CuadrosTexto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8_CuadrosTexto"
        mc:Ignorable="d"
        Title="CuadrosTexto" Height="350" Width="400"
        Icon="/Icon/icono.ico">
    <Grid>
        <TextBlock Text="Nombre" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="35,40,0,0"/>
        <TextBox x:Name="nombre" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="35,65,0,0" Width="150" Height="26"
                 VerticalContentAlignment="Center" KeyDown="Ayuda_KeyDown"/>
        <TextBlock x:Name="ayudaNombre" Text="Nombre del cliente" Foreground="Gray"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="198,70,0,0"
                   Visibility="Hidden"/>

        <TextBlock Text="Apellido" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="35,127,0,0"/>
        <TextBox x:Name="apellido" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="35,152,0,0" Width="150" Height="26"
                 VerticalContentAlignment="Center" KeyDown="Ayuda_KeyDown"/>
        <TextBlock x:Name="ayudaApellido" Text="Apellido del cliente" Foreground="Gray"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="198,157,0,0"
                   Visibility="Hidden"/>

        <TextBlock Text="Edad" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="35,220,0,0"/>
        <TextBox x:Name="edad" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="35,245,0,0" Width="150" Height="26"
                 VerticalContentAlignment="Center" KeyDown="Edad_KeyDown"/>
        <TextBlock x:Name="errorEdad" Text="Edad incorrecta" Foreground="Crimson"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="198,250,0,0"
                   Visibility="Hidden"/>
    </Grid>
</Window>
