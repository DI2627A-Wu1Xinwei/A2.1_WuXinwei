<Window x:Class="_5_FormatoTexto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5_FormatoTexto"
        mc:Ignorable="d"
        Title="Texto con formato" Height="400" Width="800"
        Icon="Icon/icono.ico">
    <Grid Margin="0,0,0,18">
        <TextBlock Text="Texto" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,50,0,0"/>
        <TextBox x:Name="texto" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="60,72,0,0" Width="177" Height="80"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 TextChanged="Texto_TextChanged"/>

        <CheckBox x:Name="negrita" Content="Negrita" FontWeight="Bold"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="276,84,0,0"
                  Checked="Negrita_Changed" Unchecked="Negrita_Changed"/>
        <CheckBox x:Name="cursiva" Content="Cursiva" FontStyle="Italic"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="388,84,0,0"
                  Checked="Cursiva_Changed" Unchecked="Cursiva_Changed"/>

        <TextBlock Text="Color del texto" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="500,84,0,0"/>
        <RadioButton x:Name="azul" Content="Azul" GroupName="color" IsChecked="True"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="615,68,0,0"
                     Checked="Azul_Checked"/>
        <RadioButton x:Name="rojo" Content="Rojo" GroupName="color"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="615,92,0,0"
                     Checked="Rojo_Checked"/>
        <RadioButton x:Name="verde" Content="Verde" GroupName="color"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="615,116,0,0"
                     Checked="Verde_Checked"/>

        <Border Background="#EAF0A8" Margin="52,0,68,122" Height="45" VerticalAlignment="Bottom">
            <TextBlock x:Name="resultado" Foreground="Blue"
                       VerticalAlignment="Center" Margin="8,0"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
