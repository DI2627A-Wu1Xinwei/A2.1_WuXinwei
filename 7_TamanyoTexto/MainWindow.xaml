<Window x:Class="_7_TamanyoTexto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_7_TamanyoTexto"
        mc:Ignorable="d"
        Title="Tamaño del texto" Height="400" Width="850"
        Icon="/Icon/icono.ico">
    <Grid>
        <TextBlock x:Name="texto" Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Desarrollo de Interfaces"
                   FontSize="36" FontWeight="Bold"
                   Foreground="#4F86E8"
                   HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" ShadowDepth="4" BlurRadius="3" Opacity="1"/>
            </TextBlock.Effect>
        </TextBlock>

        <RadioButton x:Name="pequenyo" Grid.Column="0" Content="Pequeño" Tag="36"
                     GroupName="tamanyo" IsChecked="True" FontSize="30"
                     VerticalContentAlignment="Center"
                     Checked="Tamanyo_Checked" Margin="94,48,-113,-48"/>
        <RadioButton x:Name="mediano" Content="Mediano" Tag="48"
                     GroupName="tamanyo" FontSize="30"
                     VerticalContentAlignment="Center"
                     Checked="Tamanyo_Checked" Margin="352,48,-352,-48"/>
        <RadioButton x:Name="grande" Content="Grande" Tag="72"
                     GroupName="tamanyo" FontSize="30"
                     VerticalContentAlignment="Center"
                     Checked="Tamanyo_Checked" Margin="614,48,-614,-48"/>
    </Grid>
</Window>
