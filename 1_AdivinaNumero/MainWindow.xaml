<Window x:Class="_1_AdivinaNumero.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_1_AdivinaNumero"
        mc:Ignorable="d"
        Title="AdivinaNumero" Height="250" Width="620"
        Icon="Icon/icono.ico">
    <Grid>
        <Button x:Name="comprobar" Content="Comprobar" HorizontalAlignment="Left" Margin="106,125,0,0" VerticalAlignment="Top" Height="34" Width="157" Click="Button_Click"/>
        <Button x:Name="reiniciar" Content="Reiniciar" HorizontalAlignment="Left" Margin="290,128,0,0" VerticalAlignment="Top" Height="32" Width="155" Click="Button_Click_1" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.951"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>

        <TextBlock Text="¿Qué número he pensado?" HorizontalAlignment="Left" Margin="114,79,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtNumero" HorizontalAlignment="Left" Margin="284,76,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="170" TextChanged="txtNumero_TextChanged"/>
        <TextBlock x:Name="resultado" HorizontalAlignment="Left" Margin="488,76,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="122"/>

    </Grid>
</Window>
