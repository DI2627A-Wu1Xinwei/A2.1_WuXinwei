<Window x:Class="_2_CalculadoraBasica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2_CalculadoraBasica"
        mc:Ignorable="d"
        Title="CalculadoraBasica" Height="300" Width="600"
        Icon="Icon/icono.ico">
    <Grid>
        <TextBlock Text="Operando 1" HorizontalAlignment="Left" Margin="97,30,0,0" VerticalAlignment="Top"/>
        <TextBlock Text="Operando 2" HorizontalAlignment="Left" Margin="97,80,0,0" VerticalAlignment="Top"/>
        <TextBlock Text="Operador" HorizontalAlignment="Left" Margin="97,130,0,0" VerticalAlignment="Top"/>
        <TextBlock Text="Resultado" HorizontalAlignment="Left" Margin="97,185,0,0" VerticalAlignment="Top"/>

        <TextBox x:Name="operando1" HorizontalAlignment="Left" Margin="192,24,0,0" VerticalAlignment="Top" Width="150" Height="29" VerticalContentAlignment="Center"/>
        <TextBox x:Name="operando2" HorizontalAlignment="Left" Margin="192,74,0,0" VerticalAlignment="Top" Width="150" Height="29" VerticalContentAlignment="Center"/>
        <TextBox x:Name="operador" HorizontalAlignment="Left" Margin="192,124,0,0" VerticalAlignment="Top" Width="150" Height="29" VerticalContentAlignment="Center" TextChanged="Operador_TextChanged"/>
        <TextBox x:Name="resultado" HorizontalAlignment="Left" Margin="192,179,0,0" VerticalAlignment="Top" Width="150" Height="29" VerticalContentAlignment="Center" IsReadOnly="True"/>

        <Button x:Name="calcular" Content="Calcular" HorizontalAlignment="Left" Margin="446,25,0,0" VerticalAlignment="Top" Width="76" IsDefault="True" IsEnabled="False" Click="Calcular_Click"/>
        <Button x:Name="limpiar" Content="Limpiar" HorizontalAlignment="Left" Margin="446,54,0,0" VerticalAlignment="Top" Width="76" IsCancel="True" Click="Limpiar_Click"/>
    </Grid>
</Window>
