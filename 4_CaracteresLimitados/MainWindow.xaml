<Window x:Class="_4_CaracteresLimitados.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_4_CaracteresLimitados"
        mc:Ignorable="d"
        Title="Carácteres Ilimitados" Height="477" Width="835"
        Icon="Icon/icono.ico">
    <Grid>

        <TextBox x:Name="texto" Margin="32,30,32,31"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MaxLength="140" TextChanged="Texto_TextChanged"/>

        <TextBlock x:Name="contador" Text="0/140" Foreground="Gray" FontSize="16"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,24,5"/>
    </Grid>
</Window>
